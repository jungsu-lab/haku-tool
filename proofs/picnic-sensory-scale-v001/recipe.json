  "hypotheses_under_test": [
    "A sensory relay becomes meaningful when each scale adds a new role: texture, action owner, embodied reaction, and relationship field.",
    "The same pink wine, hands, food, and evening light can bridge distance changes without generic color matching.",
    "The proof must fail if the vertical cover crop removes the group relationship or if the cuts merely alternate shot size."
  ],
  "purpose": "Test sensory-scale-relay as a general observational friendship edit without music, copy, effects, zoom, retime, or reference-media reuse.",
  "material_fit": {
    "status": "conditional_on_vertical_crop",
    "strengths": [
      "The sources share people, objects, location, time, light, and social action.",
      "Each planned shot contributes different information rather than a duplicate crop.",
      "The shared toast supplies a real relationship destination."
    ],
    "risks": [
      "Landscape group footage may lose people in a 9:16 cover crop.",
      "The material supports friendship atmosphere but not a product claim or brand recovery."
    ]
  },
  "audio_policy": "deferred_by_user",
  "canvas": {
    "width": 720,
    "height": 1280,
    "fps": 25
  },
  "render_policy": {
